
@inherits UmbracoViewPage<Guid>
@{
    var entityKey = Model;
    var type = Mvc.GetSafeViewDataString(this.ViewData,"EntityType");
    var linkTitle = Mvc.GetSafeViewDataString(this.ViewData,"LinkTitle", "Edit");

    var url = "";
    switch (type)
    {
        case "DataType":
            url = Helper.GetBackofficeEntityUrl(Helper.EntityType.DataType, entityKey);
            break;

        case "DocType":
            url = Helper.GetBackofficeEntityUrl(Helper.EntityType.DocType, entityKey);  
            break;
            
        case "Template":
            url = Helper.GetBackofficeEntityUrl(Helper.EntityType.Template, entityKey);
            break;
    }
    
}
@if (entityKey != Guid.Empty)
{
    <a href="@url" target="_blank">@linkTitle</a>
}

