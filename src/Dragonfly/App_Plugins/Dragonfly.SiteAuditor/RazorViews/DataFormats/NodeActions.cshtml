@inherits UmbracoViewPage<AuditableContent>
@{
	AuditableContent content = Model;

	var editUrl = Helper.GetBackofficeEntityUrl(Helper.EntityType.ContentNode, content.GuidKey);
}

<a href="@editUrl" target="_blank">Edit</a>

@if (content.IsPublished)
{
	try
	{
		<span> | </span><a href="@content.UmbPublishedNode.Url()" target="_blank">View</a>
	}
	catch (Exception e)
	{
		<span> | [Error - No Published Url]</span>
		<!-- Exception: @e.Message  -->
	}

}